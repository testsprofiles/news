# Production environment template
# `deploy.sh` copies this file to `.env` on first run and fills SECRET_KEY and
# DB_PASSWORD with securely generated values. Never commit the real `.env`
# (it is git-ignored).

# --- Flask / app ---
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_PORT=5000
PORT=5000
GUNICORN_WORKERS=4

# --- PostgreSQL (host "db" is the docker-compose service name) ---
DB_HOST=db
DB_PORT=5432
DB_NAME=news_db
DB_USER=postgres
DB_PASSWORD=change_me_strong_db_password

# JWT signing key. MUST be at least 32 bytes for HS256.
SECRET_KEY=change_me_to_a_random_32_byte_or_longer_secret

# --- Telegram bot (optional; leave empty to disable notifications) ---
BOT_TOKEN=
WEBAPP_URL=
CHANNEL_ID=

# --- Server (used by deploy tooling) ---
SERVER_IP=2.29.24.32
SSH_USER=root
PROJECT_PATH=/var/www/news
